{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["NEXT_TELEMETRY_DISABLED"]
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "outputs": [],
      "env": ["MANDATE_TEST_DATABASE_URL", "MANDATE_TEST_API_URL", "MANDATE_TEST_ADMIN_KEY"]
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "MANDATE_*",
        "HOST",
        "PORT",
        "LOG_LEVEL",
        "NODE_ENV",
        "NEXT_TELEMETRY_DISABLED"
      ]
    }
  }
}
