# Copy to .env (git-ignored). The API and db:migrate read these.

# Postgres 16 from `docker compose up -d` (the default when unset):
DATABASE_URL=postgres://mandate:mandate@localhost:5432/mandate
# Or, without Docker, an embedded Postgres (PGlite) persisted under .mandate/:
# DATABASE_URL=pglite:.mandate/pglite

# Ed25519 private key (64 hex chars) that signs receipts and mandate tokens.
# Required in production. In development a key is generated into .mandate/ when unset.
# MANDATE_SIGNING_KEY=
# MANDATE_SIGNING_KEY_ID=mandate-key-1

# Apply migrations on API start (always on for pglite):
# MANDATE_AUTO_MIGRATE=1

# HOST=127.0.0.1
# PORT=4000
