{
  "name": "@mandate/api",
  "version": "0.0.0",
  "private": true,
  "description": "Mandate HTTP API (Fastify)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "bootstrap": "tsx src/cli/bootstrap.ts"
  },
  "dependencies": {
    "@mandate/crypto": "workspace:*",
    "@mandate/db": "workspace:*",
    "@mandate/engine": "workspace:*",
    "@mandate/policy": "workspace:*",
    "@mandate/schema": "workspace:*",
    "fastify": "5.12.5",
    "zod": "^3.25.0"
  }
}
