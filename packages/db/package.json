{
  "name": "@mandate/db",
  "version": "0.0.0",
  "private": true,
  "description": "Postgres 16 schema, migrations and data access for Mandate",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "migrate": "tsx src/cli/migrate.ts",
    "generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@mandate/schema": "workspace:*",
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@mandate/crypto": "workspace:*",
    "drizzle-kit": "0.31.11"
  }
}
