{
  "name": "@mandate/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript SDK for the Mandate API",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mandate/crypto": "workspace:*",
    "@mandate/schema": "workspace:*"
  },
  "devDependencies": {
    "@mandate/api": "workspace:*",
    "@mandate/db": "workspace:*"
  }
}
